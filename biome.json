{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "files": {
    "includes": ["*.mjs", "*.json", "!**/node_modules"]
  }
}
